# Copy this file to .env and fill in the values
# cp .env.example .env

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas or local
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Generate strong random secrets (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret

# Google Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-flash-thinking-exp
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=

# Feature flags
ENABLE_VIDEO_GEN=false
IMAGE_CONCURRENCY=3
MAX_GEMINI_CALLS_PER_CASE=40
DAILY_CASE_QUOTA_USER=5
DAILY_CASE_QUOTA_GUEST=2
